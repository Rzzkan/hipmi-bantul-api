# ============================================================
#  PRODUCTION — CMS & API HIPMI Bantul  (https://api.hipmibantul.com)
#  Salin ke `.env` di server, lalu isi bagian bertanda <ISI>.
# ============================================================
APP_NAME="CMS HIPMI Bantul"
APP_ENV=production
APP_KEY=                      # <ISI> jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.hipmibantul.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database (disarankan MySQL/MariaDB di production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hipmi_bantul_cms
DB_USERNAME=hipmi_bantul       # <ISI>
DB_PASSWORD=                   # <ISI>

# --- Session (admin panel /admin di domain api) ---
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_DOMAIN=api.hipmibantul.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# --- Akun admin pertama (dipakai saat `php artisan db:seed`) ---
ADMIN_EMAIL=okkhipmibantul@gmail.com
ADMIN_PASSWORD=okkbergerak     # kosongkan = pakai default dari AdminUserSeeder

# --- Koneksi ke website (Next.js) ---
FRONTEND_URL=https://web.hipmibantul.com
FRONTEND_REVALIDATE_URL=https://web.hipmibantul.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=    # <ISI> sama persis dengan REVALIDATE_SECRET di web
CORS_ALLOWED_ORIGINS=https://web.hipmibantul.com

# --- Penyimpanan gambar ---
# public = disk server (storage/app/public) · r2 = Cloudflare R2
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=          # <ISI>
R2_SECRET_ACCESS_KEY=      # <ISI>
R2_BUCKET=hipmi-bantul
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=               # <ISI> https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# URL publik bucket: custom domain (disarankan) atau https://pub-xxxx.r2.dev
# Bisa diganti kapan saja dari admin: Pengaturan Situs → Media (R2). Nilai di admin menang.
R2_PUBLIC_URL=https://media.hipmibantul.site
# Folder di dalam bucket (bisa berbagi bucket dengan Katalog Bisnis)
R2_ROOT=cms

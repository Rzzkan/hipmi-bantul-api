# ============================================================
#  PRODUCTION — CMS & API HIPMI Bantul  (https://api.hipmibantul.com)
#  Salin ke `.env` di server, lalu isi bagian bertanda <ISI>.
# ============================================================
APP_NAME="CMS HIPMI Bantul"
APP_ENV=production
APP_KEY=                      # <ISI> jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.hipmibantul.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database (disarankan MySQL/MariaDB di production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hipmi_bantul_cms
DB_USERNAME=hipmi_bantul       # <ISI>
DB_PASSWORD=                   # <ISI>

# --- Session (admin panel /admin di domain api) ---
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_DOMAIN=api.hipmibantul.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# --- Akun admin pertama (dipakai saat `php artisan db:seed`) ---
ADMIN_EMAIL=admin@hipmibantul.com
ADMIN_PASSWORD=                # <ISI> password kuat, ganti setelah login

# --- Koneksi ke website (Next.js) ---
FRONTEND_URL=https://hipmibantul.com
FRONTEND_REVALIDATE_URL=https://hipmibantul.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=    # <ISI> sama persis dengan REVALIDATE_SECRET di web
CORS_ALLOWED_ORIGINS=https://hipmibantul.com,https://www.hipmibantul.com
